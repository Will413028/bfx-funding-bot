# Operator installs under a root-controlled directory, root:root mode0600.
# Examples only; never copy real secrets into git/chat/reports. No inline comments.
# Existing local PG18 and restricted role, not migration owner or retired Neon.
DATABASE_URL=postgresql://bfx_bot:REPLACE@bfx-postgres:5432/bfx
BFX_ADMIN_TOKEN=
BFX_VAULT_KEK=<base64-encoded-32-byte-kek>
# Operator alerts from the bot (T8): same values as /opt/bfx/runtime/notify.env.
# Both empty = alerts are logged only (the bot says so once at boot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Account and operator identity (nonsecret; the retired release bundle used to inject
# these). Non-secret bot settings come from deploy/vm/live.env at the deployed commit.
BFX_EXCHANGE_ACCOUNT_ID=replace-with-canonical-exchange-account-uuid
BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
# Money is decided only by the applied CapitalPolicy. Do not copy .env.runtime or
# BFX_CANARY_*/amount/cap/buffer/scope legacy keys.
# The separate protected webapi.env must contain the SAME BFX_ADMIN_TOKEN for
# read-only funding status, its own bfx_webapi DATABASE_URL and these settings:
# BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
# BFX_OPERATOR_ROLE=admin
# BETTER_AUTH_JWKS_URL=http://bfx-frontend:3000/api/auth/jwks
# frontend.env uses bfx_webauth DATABASE_URL; preserve Redis/auth secrets.
# bfx-deploy rejects values with `$`, surrounding quotes or ` #`, and loader/
# identity keys (PYTHONPATH, LD_*, BFX_IMAGE_DIGEST, ...). Procedure:
# docs/runbooks/deploy.md; first install: docs/runbooks/cutover-release-governance.md
