# Copy to ~/bfx/bot.env on the VM, chmod 600, fill real values. Never commit.
DATABASE_URL=postgresql://USER:PASS@ep-...-pooler.ap-southeast-1.aws.neon.tech/DB   # raw Neon URL ok (code rewrites scheme/strips -pooler)
BFX_ADMIN_TOKEN=
BFX_EXCHANGE_ACCOUNT_ID=<exchange-account-uuid>
BFX_VAULT_KEK=<base64-encoded-32-byte-kek>
BFX_SERVICE_VERSION=

# The separate ~/bfx/webapi.env must also contain the same operator ID and role:
# BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
# BFX_OPERATOR_ROLE=admin
