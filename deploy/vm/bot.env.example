# Operator installs under a root-controlled directory, root:root mode0600.
# Examples only; never copy real secrets into git/chat/reports. No inline comments.
# Existing local PG18 and restricted role, not migration owner or retired Neon.
DATABASE_URL=postgresql://bfx_bot:REPLACE@bfx-postgres:5432/bfx
BFX_ADMIN_TOKEN=
BFX_ADMIN_READ_TOKEN=
BFX_VAULT_KEK=<base64-encoded-32-byte-kek>
# Operator alerts from the bot (T8): same values as /opt/bfx/runtime/notify.env.
# Both empty = alerts are logged only (the bot says so once at boot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Error tracking (Sentry project bfx-backend; webapi.env carries the same DSN).
# Empty = off. docs/runbooks/operations.md "Error tracking".
SENTRY_DSN=

# Account identity (nonsecret; the retired release bundle used to inject it).
# Non-secret bot settings come from deploy/vm/live.env at the deployed commit.
BFX_EXCHANGE_ACCOUNT_ID=replace-with-canonical-exchange-account-uuid
# Money is decided only by the applied CapitalPolicy. Do not copy .env.runtime or
# BFX_CANARY_*/amount/cap/buffer/scope legacy keys.
# The separate protected webapi.env must contain the SAME BFX_ADMIN_READ_TOKEN for
# read-only funding status (never BFX_ADMIN_TOKEN: the bot accepts only that one for
# halt; never BFX_VAULT_KEK: the web API refuses to start with either), its own bfx_webapi DATABASE_URL, SENTRY_DSN (same as here) and the tailnet
# ingress keys (BFX_OPERATOR_TAILNET_USER_ID, BFX_WEBAPI_ALLOWED_HOSTS,
# BFX_FE_SENTRY_DSN; core/settings.py IngressSettings).
# bfx-deploy rejects values with `$`, surrounding quotes or ` #`, and loader/
# identity keys (PYTHONPATH, LD_*, BFX_IMAGE_DIGEST, ...). Procedure:
# docs/runbooks/deploy.md; first install: docs/runbooks/fresh-host-setup.md
