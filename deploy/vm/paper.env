BFX_PHASE=paper
BFX_DEPLOYMENT_ENV=ci
BFX_RUN_DURATION_HOURS=1
BFX_HEALTHZ_PORT=8080
# Placeholders only: the daemon loads Credentials unconditionally (daemon.py
# build_daemon), but the paper executor is simulated (EchoPaperExecutor) and
# NEVER authenticates — these are never used to reach the venue. Keeping them
# here (not real keys) lets paper boot without operator secrets.
BFX_API_KEY=paper-unused
BFX_API_SECRET=paper-unused
