BFX_PHASE=paper
BFX_DEPLOYMENT_ENV=ci
BFX_EXECUTION_POLICY=paper
BFX_RUN_DURATION_HOURS=1
BFX_HEALTHZ_PORT=8080
# Identity and operator ID are supplied from the protected VM env file.  The
# report path is an immutable redacted artifact, never a secret payload.
BFX_PROJECTOR_VERSION=execution-state-v1
BFX_HALT2_EVIDENCE_REPORT=/var/lib/bfx/evidence/halt2-paper.json
# The daemon still bootstraps the account-owned credential vault in paper; the
# simulated executor never sends this credential to a venue.
