# /opt/bfx/runtime/frontend.env (VM, root:root 0600) — Better Auth FE runtime (server-only).
# Build-time NEXT_PUBLIC_* are baked into the image by CI from the GitHub repository
# variables of the same names; keep the copies below identical to those variables.
# <public-host> is the frontend's public host name (docs/runbooks/fresh-host-setup.md §2).
NEXT_PUBLIC_APP_URL=https://<public-host>
NEXT_PUBLIC_APP_NAME=bfx-funding-bot
NEXT_PUBLIC_BETTER_AUTH_URL=https://<public-host>
API_URL=http://webapi:8000
BETTER_AUTH_URL=https://<public-host>
BETTER_AUTH_SECRET=<openssl rand -base64 48>
DATABASE_URL=postgresql://bfx_webauth:<pw>@postgres:5432/bfx
REDIS_URL=redis://redis:6379
PASSKEY_RP_ID=<public-host>
# Must match BFX_OPERATOR_USER_ID in /opt/bfx/runtime/webapi.env; role is fixed to admin.
BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
BFX_OPERATOR_ROLE=admin
