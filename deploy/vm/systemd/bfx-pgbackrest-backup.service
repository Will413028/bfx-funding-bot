[Unit]
Description=Create the scheduled bfx pgBackRest backup
Requires=docker.service
After=docker.service
# A failed scheduled backup alerts at once (root-only Telegram credentials live in
# the alert unit, not here). Freshness/RPO is watched by bfx-backup-check.timer.
OnFailure=bfx-alert@%n.service

[Service]
Type=oneshot
TimeoutStartSec=7200
User=ubuntu
# The deployed release's DR scripts: bfx-deploy points `current` at each release
# it deploys (a clean git worktree), never at the mirror's working tree.
WorkingDirectory=/home/ubuntu/bfx-releases/current
ExecStart=/home/ubuntu/bfx-releases/current/deploy/vm/pgbackrest/backup.sh --scheduled
