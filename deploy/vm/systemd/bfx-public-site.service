[Unit]
Description=bfx public proof site: build it, upload it to Cloudflare Pages and check it is served
Documentation=file:///usr/local/lib/bfx-ops/current/ops/bfx_public_site.py
# Started by bfx-public-site.timer, or by hand: `sudo systemctl start bfx-public-site.service`.
Requires=docker.service
After=docker.service
OnFailure=bfx-alert@%n.service

[Service]
Type=oneshot
# Two users. The build (ExecStartPre=+, root) reads research.env and the deployments
# ledger and drives docker; the container runs as uid 1000 and writes only the
# RuntimeDirectory's build/. The upload (ExecStart=) runs as a DynamicUser that holds
# the Cloudflare token and the project as credentials and nothing else: no database, no
# docker. No EnvironmentFile=: it would reach the root step's interpreter too.
DynamicUser=yes
RuntimeDirectory=bfx-public-site
# Only the dynamic user (its owner) traverses it; docker binds build/ as root.
RuntimeDirectoryMode=0700
LoadCredential=cloudflare-api-token:/opt/bfx/runtime/secrets/public-site/CLOUDFLARE_API_TOKEN
LoadCredential=public-site-env:/opt/bfx/runtime/public-site.env
Environment=HOME=/
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
# build (the container's own timeout 300) + about eight API calls and the served check
# (60 s per request, VERIFY_SECONDS 120): about 1080 s when Cloudflare is at its slowest.
TimeoutStartSec=1200
ExecStartPre=+/usr/local/lib/bfx-ops/current/ops/.venv/bin/python /usr/local/lib/bfx-ops/current/ops/bfx_public_site.py build
ExecStart=/usr/local/lib/bfx-ops/current/ops/.venv/bin/python /usr/local/lib/bfx-ops/current/ops/bfx_public_site.py publish
