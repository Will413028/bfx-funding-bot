[Unit]
Description=Alert when backup evidence misses the RPO or restore tests go stale
Documentation=file:///usr/local/lib/bfx-ops/bfx_backup_check.py

[Service]
Type=oneshot
# Root: reads the DR operator's evidence by absolute path (never ~) and the
# root-only Telegram credentials. Sends its own alerts with de-duplication.
Environment=HOME=/root
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
StateDirectory=bfx-ops
StateDirectoryMode=0700
TimeoutStartSec=120
ExecStart=/usr/bin/python3 /usr/local/lib/bfx-ops/bfx_backup_check.py --evidence /home/ubuntu/bfx/dr-evidence/backup.json --restore-heartbeat /home/ubuntu/bfx/dr-evidence/restore-heartbeat.json --state /var/lib/bfx-ops/backup-check.json
