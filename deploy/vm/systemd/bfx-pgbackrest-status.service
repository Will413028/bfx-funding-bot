[Unit]
Description=Collect bfx pgBackRest status evidence
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
TimeoutStartSec=300
User=ubuntu
# The deployed release's DR scripts: bfx-deploy points `current` at each release
# it deploys (a clean git worktree), never at the mirror's working tree.
WorkingDirectory=/home/ubuntu/bfx-releases/current
ExecStart=/home/ubuntu/bfx-releases/current/deploy/vm/pgbackrest/status.sh --output /home/ubuntu/bfx/dr-evidence/backup.json
