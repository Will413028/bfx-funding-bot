[Unit]
Description=bfx weekly measurement chain (funding_stats ingest + attribution + G3 report + research re-validation)
Documentation=file:///usr/local/lib/bfx-ops/current/ops/bfx_weekly_report.py
Requires=docker.service
After=docker.service
OnFailure=bfx-alert@%n.service
# The chain builds the public proof site; bfx-public-site uploads it (and alerts on its own).
OnSuccess=bfx-public-site.service

[Service]
Type=oneshot
# Root: reads /opt/bfx/runtime/research.env (root 0600) and the deployments ledger, and
# drives docker; the container itself runs as uid 1000. The job's steps and this
# runner come from the deployed tooling release (bfx-deploy installs both after
# each successful deploy); the image is the ledger's deployed backend digest.
# Nothing reads the VM mirror's working tree.
Environment=HOME=/root
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
# The success heartbeat bfx-backup-check reads (bfx_weekly_report.HEARTBEAT).
StateDirectory=bfx-ops
StateDirectoryMode=0700
# 整條 chain 上限 95min：營運步驟（ingest 600 + attribution + G3 + delivery + 公開站 300）
# 之後接研究步驟（perp 900 + liquidations 1200 + book learn 600 + 兩次 period-structure 600 +
# OOS 600 + diff），每步 fail-soft；有 timeout 的步驟合計 5400，留 300 給沒有 timeout 的步驟；
# 防 systemd 端無限掛住。
TimeoutStartSec=5700
ExecStart=/usr/local/lib/bfx-ops/current/ops/.venv/bin/python /usr/local/lib/bfx-ops/current/ops/bfx_weekly_report.py
