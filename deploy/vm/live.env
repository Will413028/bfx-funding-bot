# Nonsecret base profile. Prepare with explicit account and operator identifiers.
# Applied CapitalPolicy is the sole money authority; no env/YAML amount fallback.
BFX_PHASE=live
BFX_DEPLOYMENT_ENV=prod
BFX_EXECUTOR=bitfinex_live
BFX_WS_CLIENT_ENABLED=true
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_PROJECTOR_VERSION=execution-state-v1
BFX_HALT2_EVIDENCE_REPORT=/run/bfx-release/halt2.json
BFX_CELLS_YAML=/app/configs/cells.live.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.live.yaml
BFX_OPERATOR_ROLE=admin
BFX_HEALTHZ_PORT=8080
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
BFX_LADDER_OBSERVE=true
BFX_OTEL_ENABLED=true
BFX_BOOK_SNAPSHOT_ENABLED=true
# 5-minute book snapshots feed the book-replay fill model (2026-09-22 review §5); ~600 MB/yr.
BFX_BOOK_SNAPSHOT_INTERVAL_S=300
# BFX_KILL_SWITCH is independent break-glass only, never a deployment default.
# Halt is durable; technical deployment requires the existing halted epoch.
