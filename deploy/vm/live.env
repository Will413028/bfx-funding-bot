# Nonsecret base profile. Prepare with an explicit account identifier.
# Applied CapitalPolicy is the sole money authority; no env/YAML amount fallback.
BFX_PHASE=live
BFX_DEPLOYMENT_ENV=prod
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_CELLS_YAML=/app/configs/cells.live.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.live.yaml
BFX_HEALTHZ_PORT=8080
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
# Reference = exact-period book reprice (orders are priced from the book; the candle
# quote reference cancelled legal book-priced offers). 2026-09-27.
BFX_REPRICE_REFERENCE=book
BFX_LADDER_OBSERVE=true
BFX_OTEL_ENABLED=true
BFX_BOOK_SNAPSHOT_ENABLED=true
# 5-minute book snapshots feed the book-replay fill model (2026-09-22 review §5); ~600 MB/yr.
BFX_BOOK_SNAPSHOT_INTERVAL_S=300
# BFX_KILL_SWITCH is independent break-glass only, never a deployment default.
# Whether the bot may trade is the durable trading state in the database;
# deployment never changes that state.
# Seven-day tenor measurement (docs/plans/2026-11-22-seven-day-tenor-measurement.md).
# All nine or none. The switch is the fUST envelope's max_period_days, not this file:
# with the envelope at 2..2 no long-tenor offer is placed.
BFX_LONG_TENOR_SYMBOL=fUST
BFX_LONG_TENOR_DAYS=7
BFX_LONG_TENOR_MIN_DAILY_RATE=0.0002
BFX_LONG_TENOR_MAX_AMOUNT=200
BFX_LONG_TENOR_MAX_OFFERS_TOTAL=1
BFX_LONG_TENOR_MAX_ENDED_CREDITS=20
BFX_LONG_TENOR_SINCE=2026-11-22
BFX_LONG_TENOR_UNTIL=2026-12-06
BFX_LONG_TENOR_OFFER_TIMEOUT_S=1800
