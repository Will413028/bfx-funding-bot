# Nonsecret profile of the simulation soak (docs/runbooks/simulation-soak.md): the live profile
# (live.env) on the simulated venue, in its own database. tests/scripts/test_shadow_profile.py
# diffs this file against live.env; only the keys below differ.
# The account (BFX_EXCHANGE_ACCOUNT_ID), the database URL, the sim-only admin token, the starting
# wallets (BFX_SIM_INITIAL_WALLETS) and the fault knob (BFX_SIM_FAULTS) come from the protected
# sim.env the runbook writes; never put them here. A shadow boot never opens the credential
# vault (BFX_VAULT_KEK must be unset) and generates throwaway keys for each boot.
BFX_PHASE=shadow
BFX_DEPLOYMENT_ENV=shadow
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
# One value drives both book services (the bot's and the venue's own): it stays below the
# venue's maximum book age (120 s) and cuts the REST this process adds to the per-IP limit
# it shares with the live bot (live: 15).
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=60
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_PROJECTOR_VERSION=execution-state-v1
BFX_CELLS_YAML=/app/configs/cells.live.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.live.yaml
BFX_OPERATOR_ROLE=admin
# Own network namespace, no published port: no clash with the live bot's 8080.
BFX_HEALTHZ_PORT=8080
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
BFX_REPRICE_REFERENCE=book
BFX_LADDER_OBSERVE=true
# Keep simulated spans out of the live traces, and the live bot's book snapshot writes
# (REST) out of the shared rate limit.
BFX_OTEL_ENABLED=false
BFX_BOOK_SNAPSHOT_ENABLED=false
