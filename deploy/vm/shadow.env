BFX_PHASE=shadow
BFX_DEPLOYMENT_ENV=shadow
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_HEALTHZ_PORT=8080
# Placeholders only: the daemon loads Credentials unconditionally (daemon.py
# build_daemon), but shadow runs the simulated executor and NEVER authenticates
# — these never reach the venue. Lets shadow boot without operator secrets.
BFX_API_KEY=shadow-unused
BFX_API_SECRET=shadow-unused
