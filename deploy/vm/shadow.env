BFX_PHASE=shadow
BFX_DEPLOYMENT_ENV=shadow
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_HEALTHZ_PORT=8080
# BFX_EXCHANGE_ACCOUNT_ID and BFX_OPERATOR_USER_ID come from protected VM env.
BFX_PROJECTOR_VERSION=halt2-v1
BFX_HALT2_EVIDENCE_REPORT=/var/lib/bfx/evidence/halt2-shadow.json
# The daemon still bootstraps the account-owned credential vault in shadow; the
# simulated executor never sends this credential to a venue.
