BFX_PHASE=canary
BFX_DEPLOYMENT_ENV=prod
BFX_EXECUTOR=bitfinex_live
BFX_WS_CLIENT_ENABLED=true
# cap is a ceiling; the balance-aware gate limits actual lending to funded available.
# realized_loss_24h stays 57 (sized to current ~500-570 funded capital, not this ceiling).
BFX_ALLOCATION_CAP_USDT=10000
BFX_CELLS_YAML=/app/configs/cells.canary.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.canary.yaml
BFX_HEALTHZ_PORT=8080
# E1 stale-offer reprice sweep — live since 2026-07-07 (was hand-edited into
# .env.runtime; committed here so deploy-vm.sh regeneration keeps it).
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
# E2 book-aware clamp — armed 2026-07-10 (strategy review; user waived the
# ~07-14 date gate, log gate still applies — see VM runbook in the plan).
BFX_CLAMP_ENABLED=true
BFX_CLAMP_MAX_DOWN_PCT=0.15
BFX_CLAMP_TAKER_MAX_PERIOD_D=7
# Spike-rung ladder OBSERVE — armed 2026-07-19 (pure logging, zero submit
# change; accumulates ladder_would_post evidence for the E3-gated experiment).
BFX_LADDER_OBSERVE=true
