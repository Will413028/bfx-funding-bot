BFX_PHASE=canary
BFX_DEPLOYMENT_ENV=prod
BFX_EXECUTOR=bitfinex_live
BFX_WS_CLIENT_ENABLED=true
# cap is a ceiling; the balance-aware gate limits actual lending to funded available.
# realized_loss_24h stays 57 (sized to current ~500-570 funded capital, not this ceiling).
#
# ⚠️ THIS KNOB DOES NOT PAUSE THE BOT. It is the LEGACY fallback, used only for a
# symbol ABSENT from safety.canary.yaml's allocation_cap.caps. fUST and fUSD are both
# listed there ({fUSD: 400, fUST: 10000}), so this value is ignored for them — setting
# it to 0 on 2026-07-27 looked like a pause and stopped nothing; the bot kept
# submitting for hours. Use BFX_KILL_SWITCH below to actually halt.
BFX_ALLOCATION_CAP_USDT=0
# ⏸ HALTED 2026-07-27 — ManualKillGuard blocks every decision at the top of the
# safety chain (hard_guards.manual_kill, enabled in safety.canary.yaml). Existing
# credits are untouched and roll off at maturity; the daemon keeps running so
# reconcile and observability stay live.
# Reason: live strategy state was fed candles mutated in place after being observed
# (23/132 sampled slots diverged, max -35.3%), and LendDecision.rate takes
# candle.close directly — so offer rates came from distorted prices (07-25 02:00:
# live 0.00023193 vs final 0.00014999 = +54.6%).
# Resume: remove this line once the 24h L3 stability check passes AND L4 v2 (N=500)
# is reviewed. Verify a resume by watching for new RESERVATION_INTENT in event_log —
# NOT by reading env vars back, which is what made the first "pause" a no-op.
# ADR: wiki/projects/bfx-funding-bot/decisions/2026-07-27-candle-immutability-bitemporal.md
BFX_KILL_SWITCH=true
BFX_CELLS_YAML=/app/configs/cells.canary.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.canary.yaml
BFX_HEALTHZ_PORT=8080
# E1 stale-offer reprice sweep — live since 2026-07-07 (was hand-edited into
# .env.runtime; committed here so deploy-vm.sh regeneration keeps it).
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
# E2 book-aware clamp — armed 2026-07-10 (strategy review; user waived the
# ~07-14 date gate, log gate still applies — see VM runbook in the plan).
BFX_CLAMP_ENABLED=true
BFX_CLAMP_MAX_DOWN_PCT=0.15
BFX_CLAMP_TAKER_MAX_PERIOD_D=7
# Spike-rung ladder OBSERVE — armed 2026-07-19 (pure logging, zero submit
# change; accumulates ladder_would_post evidence for the E3-gated experiment).
BFX_LADDER_OBSERVE=true
# OTEL traces — enabled 2026-07-19 (Tempo on the VM observability stack;
# default endpoint http://tempo:4317; unset/false = zero-overhead no-op).
BFX_OTEL_ENABLED=true
# Funding-book depth self-recording — enabled 2026-07-19 (Bitfinex serves no
# historical book; ladder-class backtests can only use data we record. Hourly,
# fail-open, observe-only).
BFX_BOOK_SNAPSHOT_ENABLED=true
