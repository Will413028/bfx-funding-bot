BFX_PHASE=canary
BFX_DEPLOYMENT_ENV=prod
BFX_EXECUTOR=bitfinex_live
BFX_WS_CLIENT_ENABLED=true
BFX_EXECUTION_POLICY=book_guarded
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
# BFX_EXCHANGE_ACCOUNT_ID, BFX_OPERATOR_USER_ID, and the immutable
# BFX_EXPECTED_IMAGE_DIGEST are required from protected VM env; this committed
# profile deliberately has no legacy BFX_ACCOUNT_ID.
BFX_PROJECTOR_VERSION=execution-state-v1
BFX_HALT2_EVIDENCE_REPORT=/var/lib/bfx/evidence/halt2-canary.json
# Halt 2 bounded-canary identity. The protected VM must supply the UUID; do
# not derive it from BFX_EXCHANGE_ACCOUNT_ID or retain a legacy BFX_ACCOUNT_ID.
# A missing setting is a startup block, not an implicit default.
# BFX_CANARY_ACCOUNT_ID=<protected UUID>
BFX_CANARY_ENVIRONMENT=prod
BFX_CANARY_SYMBOL=fUST
BFX_CANARY_CELL=fUST_a30
BFX_CANARY_STRATEGY=mean_reversion
BFX_CANARY_AMOUNT_USDT=150
BFX_CANARY_CAP_USDT=150
BFX_CANARY_MAX_EVIDENCE_AGE_SECONDS=300
# Issued only after the durable halt and pre-command readiness gates pass.
# The operator exports the returned UUID for this one canary process; a permit
# is consumed at most once and is never inferred from the evidence JSON.
# BFX_CANARY_PERMIT_ID=<issued durable permit UUID>
BFX_CANARY_EVIDENCE_REPORT=/var/lib/bfx/evidence/halt2-bounded-canary.json
# cap is a ceiling; the balance-aware gate limits actual lending to funded available.
# realized_loss_24h stays 57 (sized to current ~500-570 funded capital, not this ceiling).
#
# ⚠️ THIS KNOB DOES NOT PAUSE THE BOT. Safety caps are configured explicitly in
# safety.canary.yaml; use BFX_KILL_SWITCH below to halt new submissions.
BFX_ALLOCATION_CAP_USDT=0
# ⏸ THE CANARY IS HALTED — but the halt no longer lives here.
#
# It is a row in `trading_halt` (id=1, 2026-07-27, actor=will), read by
# ManualKillGuard on every submit. That move is the point: while the halt lived
# in this file, a plain `git revert` of it would have resumed real-money lending
# silently, with nothing having to malfunction.
#
# Reason for the halt: live strategy state was fed candles mutated in place
# after being observed (23/132 sampled slots diverged, max -35.3%), and
# LendDecision.rate takes candle.close directly — so offer rates came from
# distorted prices (07-25 02:00: live 0.00023193 vs final 0.00014999 = +54.6%).
# ADR: wiki/projects/bfx-funding-bot/decisions/2026-07-27-candle-immutability-bitemporal.md
#
# To check:  GET  /admin/trading-status   (halt.sources shows env vs persisted)
#            POST /admin/dry-evaluate     (what the guards WOULD do, right now)
# To resume: POST /admin/resume?reason=...&confirm=true
#            Gate: 24h L3 stability check passes AND L4 v2 (N=500) reviewed.
#
# BFX_KILL_SWITCH is intentionally UNSET here. It remains available as
# break-glass — set it to halt without a working database — and it takes
# precedence over the persisted state when set. Leaving it set permanently
# would hide whether the persisted halt actually works, since it
# short-circuits the guard before the DB is ever consulted.
BFX_CELLS_YAML=/app/configs/cells.canary.yaml
BFX_SAFETY_CONFIG=/app/configs/safety.canary.yaml
BFX_HEALTHZ_PORT=8080
# E1 stale-offer reprice sweep — live since 2026-07-07 (was hand-edited into
# .env.runtime; committed here so deploy-vm.sh regeneration keeps it).
BFX_REPRICE_ENABLED=true
BFX_REPRICE_TOLERANCE_PCT=0.10
BFX_REPRICE_MIN_AGE_S=1800
BFX_REPRICE_MAX_CANCELS_PER_TICK=3
# Spike-rung ladder OBSERVE — armed 2026-07-19 (pure logging, zero submit
# change; accumulates ladder_would_post evidence for the E3-gated experiment).
BFX_LADDER_OBSERVE=true
# OTEL traces — enabled 2026-07-19 (Tempo on the VM observability stack;
# default endpoint http://tempo:4317; unset/false = zero-overhead no-op).
BFX_OTEL_ENABLED=true
# Funding-book depth self-recording — enabled 2026-07-19 (Bitfinex serves no
# historical book; ladder-class backtests can only use data we record. Hourly,
# fail-open, observe-only).
BFX_BOOK_SNAPSHOT_ENABLED=true
