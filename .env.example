# Backend
PORT=8080
ENVIRONMENT=development
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"

# Release 0 web API containment: only this Better Auth user with the admin
# role may access private backend routes. The ID must be the Better Auth user ID.
BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
BFX_OPERATOR_ROLE=admin

# Process liveness (`/health`) never probes the database. `/ready` performs a
# bounded `SELECT 1` plus an Alembic head check with this timeout (maximum 10
# seconds) and returns 503 when the DB is unavailable or migrations are stale.
BFX_READINESS_TIMEOUT_SECONDS=2.0

# Redis (Upstash) - TLS uses rediss:// scheme
REDIS_URL="rediss://default:your-password@your-host.upstash.io:6379"

# Execution policy. Choose one explicit mode: paper, book_guarded,
# optimizer_shadow, or optimizer_live. Every non-paper policy requires the
# book settings below; optimizer_live also requires the fee and model artifact.
BFX_EXECUTION_POLICY=paper
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_OPTIMIZER_FEE_RATE=0.00
BFX_FILL_MODEL_ARTIFACT=models/fUSD-fill-model.json
