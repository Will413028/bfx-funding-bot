DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname
BITFINEX_API_BASE_URL=https://api-pub.bitfinex.com
LOG_LEVEL=INFO

# Execution policy. Choose one explicit mode: paper, book_guarded,
# optimizer_shadow, or optimizer_live. Live-capable modes require all book
# settings below; optimizer_live also requires BFX_FILL_MODEL_ARTIFACT.
BFX_EXECUTION_POLICY=paper
BFX_BOOK_MAX_AGE_SECONDS=30
BFX_BOOK_RECONCILE_INTERVAL_SECONDS=15
BFX_BOOK_MAX_DOWN_PCT=0.15
BFX_OPTIMIZER_FEE_RATE=0.00
BFX_FILL_MODEL_ARTIFACT=models/fUSD-fill-model.json
