{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/src/**/*.ts",
      "**/src/**/*.tsx",
      "**/e2e/**/*.ts",
      "!**/dist",
      "!**/.next",
      "!**/node_modules",
      "!**/src/types/api.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "off"
      },
      "a11y": {
        "useAltText": "off",
        "useKeyWithClickEvents": "off",
        "useButtonType": "off"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "suspicious": {
        "noUnknownAtRules": "off",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["**/e2e/**"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
