# Public (browser-visible, requires NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=bfx-funding-bot
NEXT_PUBLIC_SENTRY_DSN=   # optional
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Server-only
API_URL=http://localhost:8080
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=   # npx @better-auth/cli@latest secret
DATABASE_URL=postgresql://bfx_webauth:PASS@localhost:5432/bfx   # VM-local Postgres, auth schema (direct, no -pooler, no sslmode)
REDIS_URL=redis://localhost:6379   # VM-local Redis (Better Auth secondaryStorage)
PASSKEY_RP_ID=localhost

# Release 0 operator-only containment. Must match the backend web-API env.
BFX_OPERATOR_USER_ID=replace-with-better-auth-user-id
BFX_OPERATOR_ROLE=admin
